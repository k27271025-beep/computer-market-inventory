<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<connectionStrings>
		<!-- Строка для Dapper (используется в нашем DbService) -->
		<add name="DefaultConnection"
			 connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=ComputerMarketDB;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />

		<!-- Строка для визуального дизайнера Visual Studio (на случай, если будешь использовать DataSet) -->
		<add name="ComputerMarketInventory.Properties.Settings.ComputerMarketDBConnectionString"
			 connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=ComputerMarketDB;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>